# TSV_nominal -- DC conduction by the k <-> sigma analogy. Generated by
# scripts/phase0mr/moose_conduction.py. Both terminals are Dirichlet (equipotential).
[Mesh]
  [gen]
    type = GeneratedMeshGenerator
    dim = 3
    nx = 120
    ny = 120
    nz = 24
    xmin = -0.0001 xmax = 0.0001
    ymin = -0.0001 ymax = 0.0001
    zmin = 0 zmax = 4e-05
  []
  [via]
    type = ParsedSubdomainMeshGenerator
    input = gen
    combinatorial_geometry = 'x*x + y*y <= 2.25e-10 & z <= 3e-05'
    block_id = 1
  []
  [pad]
    type = ParsedSubdomainMeshGenerator
    input = via
    combinatorial_geometry = 'x*x + y*y <= 3.24e-10 & z > 3e-05 & z <= 4e-05'
    block_id = 2
  []
  [trace]
    type = ParsedSubdomainMeshGenerator
    input = pad
    combinatorial_geometry = 'x >= 0 & y <= 5e-06 & y >= -5e-06 & z > 3e-05 & z <= 4e-05'
    block_id = 2
  []
  [inlet]
    type = ParsedGenerateSideset
    input = trace
    combinatorial_geometry = 'z < 1e-12'
    included_subdomains = '1'
    normal = '0 0 -1'
    new_sideset_name = 'inlet'
  []
  [outlet]
    type = ParsedGenerateSideset
    input = inlet
    combinatorial_geometry = 'x > 9.9999999e-05'
    included_subdomains = '2'
    normal = '1 0 0'
    new_sideset_name = 'outlet'
  []
[]

[Variables]
  [V]
    initial_condition = 0.5
  []
[]

[Kernels]
  [cond]
    type = HeatConduction
    variable = V
  []
[]

[Materials]
  [diel]
    type = HeatConductionMaterial
    block = '0'
    thermal_conductivity = 46.8545377
  []
  [mvia]
    type = HeatConductionMaterial
    block = '1'
    thermal_conductivity = 46854537.7
  []
  [mmet]
    type = HeatConductionMaterial
    block = '2'
    thermal_conductivity = 46854537.7
  []
[]

[BCs]
  [term_in]
    type = DirichletBC
    variable = V
    boundary = 'inlet'
    value = 1.0
  []
  [term_out]
    type = DirichletBC
    variable = V
    boundary = 'outlet'
    value = 0.0
  []
[]

[Postprocessors]
  [Q_in]
    type = SideDiffusiveFluxIntegral
    variable = V
    boundary = 'inlet'
    diffusivity = thermal_conductivity
  []
  [Q_out]
    type = SideDiffusiveFluxIntegral
    variable = V
    boundary = 'outlet'
    diffusivity = thermal_conductivity
  []
  [area_in]
    type = AreaPostprocessor
    boundary = 'inlet'
  []
  [vol_via]
    type = VolumePostprocessor
    block = '1'
  []
  [vol_metal]
    type = VolumePostprocessor
    block = '2'
  []
[]

[Executioner]
  type = Steady
  solve_type = NEWTON
  petsc_options_iname = '-pc_type -pc_hypre_type'
  petsc_options_value = 'hypre boomeramg'
  nl_rel_tol = 1e-11
  l_tol = 1e-12
[]

[Outputs]
  csv = true
  exodus = false
[]
